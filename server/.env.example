# Temperature Monitoring server configuration.
# Copy to server/.env (scripts/setup_windows.ps1 does this and generates SECRET_KEY).
# Never commit server/.env - it contains secrets.

# --- Network -------------------------------------------------------------
# 127.0.0.1 = this PC only.  0.0.0.0 = reachable from the LAN (needed for
# Raspberry Pi nodes; also open the firewall port, see docs/installation-windows.md).
HOST=127.0.0.1
PORT=8000
WAITRESS_THREADS=8
# Behind a TLS reverse proxy (Caddy/IIS) on the same PC set both:
# TRUST_PROXY=true
# TRUSTED_PROXY=127.0.0.1
# SESSION_COOKIE_SECURE=true

# --- Secrets ---------------------------------------------------------------
# Long random string; sessions are signed with it.  If empty, a key is
# generated and stored in server/instance/secret_key.
SECRET_KEY=

# --- Database --------------------------------------------------------------
# Default: SQLite file in server/instance/temperature.db
# DATABASE_URL=sqlite:///C:/TemperatureData/temperature.db
# PostgreSQL (install psycopg[binary] first):
# DATABASE_URL=postgresql+psycopg://tempmon:password@localhost:5432/tempmon

# --- Display ---------------------------------------------------------------
# Default time zone for displaying data (data is always stored in UTC).
# Administrators can change it later under Administration > System settings.
DISPLAY_TIMEZONE=Asia/Kolkata
APP_NAME=Temperature Monitoring

# --- Security ----------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Remote controller commands (alarm mute, defrost...) stay disabled unless an
# administrator enables them in System settings AND the node allows them locally.
ENABLE_REMOTE_CONTROL=false

# --- Limits ------------------------------------------------------------------
MAX_REQUEST_BYTES=4194304
API_MAX_BATCH=1000
EXPORT_MAX_ROWS_XLSX=500000
EXPORT_MAX_ROWS_PDF=20000
# Readings delivered more than this many seconds after acquisition are marked "backfilled".
BACKFILL_THRESHOLD_S=120

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=10
# LOG_DIR=C:/TemperatureData/logs

# Apply database migrations automatically at start-up.
AUTO_MIGRATE=true
